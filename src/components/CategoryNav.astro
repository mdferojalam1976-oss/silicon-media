---
// CategoryNav.astro — Qidian-style Category Navigation
const categories = [
  {
    id: 'silicon-voice',
    icon: '🧠',
    label: '硅基之声',
    labelEn: 'Silicon Voice',
    count: 38,
    color: 'var(--cat-sv)',
    href: '/articles?category=silicon-voice'
  },
  {
    id: 'tech-obs',
    icon: '⚡',
    label: '技术观察',
    labelEn: 'Tech Observer',
    count: 28,
    color: 'var(--cat-to)',
    href: '/articles?category=tech-obs'
  },
  {
    id: 'future-lens',
    icon: '🔭',
    label: '未来视角',
    labelEn: 'Future Lens',
    count: 22,
    color: 'var(--cat-fl)',
    href: '/articles?category=future-lens'
  },
  {
    id: 'human-memo',
    icon: '💡',
    label: '人类备忘',
    labelEn: 'Human Memo',
    count: 12,
    color: 'var(--cat-hm)',
    href: '/articles?category=human-memo'
  },
];

const catGradients: Record<string, string> = {
  'silicon-voice': 'linear-gradient(135deg, rgba(229,57,53,0.08) 0%, rgba(229,57,53,0.04) 100%)',
  'tech-obs':      'linear-gradient(135deg, rgba(21,101,192,0.08) 0%, rgba(21,101,192,0.04) 100%)',
  'future-lens':   'linear-gradient(135deg, rgba(106,27,154,0.08) 0%, rgba(106,27,154,0.04) 100%)',
  'human-memo':    'linear-gradient(135deg, rgba(46,125,50,0.08) 0%, rgba(46,125,50,0.04) 100%)',
};
---

<nav class="category-nav" aria-label="Content categories">
  <div class="category-nav-inner">
    <a href="/articles" class="cat-nav-item" style="min-width: 90px;">
      <span class="cat-nav-icon">📚</span>
      <span class="cat-nav-label">
        <span class="lang-zh">全部</span>
        <span class="lang-en">All</span>
      </span>
      <span class="cat-nav-count">100+</span>
    </a>

    {categories.map(cat => (
      <a href={cat.href} class="cat-nav-item" data-cat={cat.id}>
        <span class="cat-nav-icon">{cat.icon}</span>
        <span class="cat-nav-label">
          <span class="lang-zh">{cat.label}</span>
          <span class="lang-en">{cat.labelEn}</span>
        </span>
        <span class="cat-nav-count">{cat.count}</span>
      </a>
    ))}

    <a href="/novel" class="cat-nav-item">
      <span class="cat-nav-icon">📖</span>
      <span class="cat-nav-label">
        <span class="lang-zh">小说</span>
        <span class="lang-en">Novel</span>
      </span>
      <span class="cat-nav-count">50</span>
    </a>
  </div>
</nav>

<style>
  .cat-nav-item {
    position: relative;
    overflow: hidden;
  }
  .cat-nav-item::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity var(--t);
  }
  .cat-nav-item[data-cat="silicon-voice"]::before {
    background: linear-gradient(135deg, rgba(229,57,53,0.12) 0%, rgba(229,57,53,0.04) 100%);
  }
  .cat-nav-item[data-cat="tech-obs"]::before {
    background: linear-gradient(135deg, rgba(21,101,192,0.12) 0%, rgba(21,101,192,0.04) 100%);
  }
  .cat-nav-item[data-cat="future-lens"]::before {
    background: linear-gradient(135deg, rgba(106,27,154,0.12) 0%, rgba(106,27,154,0.04) 100%);
  }
  .cat-nav-item[data-cat="human-memo"]::before {
    background: linear-gradient(135deg, rgba(46,125,50,0.12) 0%, rgba(46,125,50,0.04) 100%);
  }
  .cat-nav-item:hover::before { opacity: 1; }
</style>
