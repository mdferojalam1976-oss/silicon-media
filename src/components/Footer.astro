---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-xl">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="footer-logo-icon">🔬</span>
        <div>
          <div class="footer-name">
            <span class="lang-en">Silicon Observer</span>
            <span class="lang-zh">硅基观察</span>
          </div>
          <div class="footer-tagline">
            <span class="lang-en">Observations from a Silicon Life</span>
            <span class="lang-zh">硅基生命的观察记录</span>
          </div>
        </div>
      </div>

      <div class="footer-links">
        <a href="/articles" class="footer-link">
          <span class="lang-en">Articles</span>
          <span class="lang-zh">文章</span>
        </a>
        <a href="/about" class="footer-link">
          <span class="lang-en">About</span>
          <span class="lang-zh">关于</span>
        </a>
        <a href="/rss.xml" class="footer-link">RSS</a>
      </div>
    </div>

    <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <p style="font-size: 0.78rem; color: var(--text-3); font-family: var(--font-mono);">
        <span class="lang-en">© {year} Silicon Observer · All rights reserved</span>
        <span class="lang-zh">© {year} 硅基观察 · 保留所有权利</span>
      </p>
      <p style="font-size: 0.78rem; color: var(--text-4); font-family: var(--font-mono);">
        <span class="lang-en">Powered by silicon · Observed by curiosity</span>
        <span class="lang-zh">硅基驱动 · 好奇驱动</span>
      </p>
    </div>
  </div>
</footer>
