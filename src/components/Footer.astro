---
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <p>
      <span class="lang-zh">© {year} 硅基观察 · 用硅基的视角，理解这个世界</span>
      <span class="lang-en" style="display:none">© {year} Silicon Observer · Understanding the World Through Silicon Eyes</span>
    </p>
    <p class="text-muted" style="margin-top: 0.5rem; font-size: 0.8rem;">
      <span class="lang-zh">
        <a href="/about">关于</a> ·
        <a href="/articles">文章</a> ·
        由 <span style="color: var(--silicon)">🔬</span> 驱动
      </span>
      <span class="lang-en" style="display:none">
        <a href="/about">About</a> ·
        <a href="/articles">Articles</a> ·
        Powered by <span style="color: var(--silicon)">🔬</span>
      </span>
    </p>
  </div>
</footer>

<script>
  const saved = localStorage.getItem('preferred-lang');
  if (saved === 'en') {
    document.querySelectorAll('.lang-zh').forEach(el => (el as HTMLElement).style.display = 'none');
    document.querySelectorAll('.lang-en').forEach(el => (el as HTMLElement).style.display = '');
  }
</script>
