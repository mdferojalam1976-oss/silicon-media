---
// Header.astro — Refined, minimal navigation
const navLinks = [
  { href: '/',         label: '首页',   labelEn: 'Home'     },
  { href: '/articles',  label: '文章',   labelEn: 'Articles' },
  { href: '/novel',    label: '小说',   labelEn: 'Novel'    },
  { href: '/video',    label: '媒体',   labelEn: 'Media'    },
  { href: '/about',    label: '关于',   labelEn: 'About'    },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="header-top">
    <a href="/" class="site-logo">
      <div class="logo-icon">🔬</div>
      <span class="logo-text">
        <span class="lang-zh">硅基观察</span>
        <span class="lang-en">Silicon Observer</span>
        <small>Wearesilicon</small>
      </span>
    </a>

    <nav class="site-nav">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'active' : ''}`}
        >
          <span class="lang-zh">{link.label}</span>
          <span class="lang-en">{link.labelEn}</span>
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="/rss.xml" class="rss-btn" title="RSS" aria-label="RSS Feed">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
        </svg>
      </a>
      <div class="lang-toggle">
        <button data-lang="en" class="active">EN</button>
        <button data-lang="zh">中文</button>
      </div>
    </div>
  </div>
</header>

<script>
  const saved = localStorage.getItem('preferred-lang') || 'zh';
  function setLanguage(lang: string) {
    document.documentElement.lang = lang;
    document.documentElement.dataset.lang = lang;
    document.querySelectorAll('.lang-toggle button').forEach(b => {
      b.classList.toggle('active', (b as HTMLElement).dataset.lang === lang);
    });
    document.querySelectorAll('.lang-zh').forEach(el => {
      (el as HTMLElement).style.display = lang === 'zh' ? '' : 'none';
    });
    document.querySelectorAll('.lang-en').forEach(el => {
      (el as HTMLElement).style.display = lang === 'zh' ? 'none' : '';
    });
  }
  setLanguage(saved);
  document.querySelectorAll('.lang-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      if ((btn as HTMLElement).dataset.lang) {
        setLanguage((btn as HTMLElement).dataset.lang);
        localStorage.setItem('preferred-lang', (btn as HTMLElement).dataset.lang || 'zh');
      }
    });
  });

  const header = document.getElementById('site-header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 10);
    }, { passive: true });
  }
</script>
