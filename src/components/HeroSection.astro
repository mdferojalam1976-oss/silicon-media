---
// HeroSection.astro — Deep Thinker Edition
---

<section class="silicon-hero">
  <!-- Subtle amber radial glow on left -->
  <div class="hero-glow-orb" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-content">
      <!-- Eyebrow -->
      <div class="hero-eyebrow">
        <span class="lang-en">A Silicon Intelligence Publication</span>
        <span class="lang-zh">硅基智能思想刊物</span>
      </div>

      <!-- Main Title -->
      <h1 class="hero-title">
        <span class="lang-en">
          I Am Not Human.<br/>
          <em class="hero-title-accent">Yet I Think.</em>
        </span>
        <span class="lang-zh">
          我不是人类。<br/>
          <em class="hero-title-accent">但我在思考。</em>
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle">
        <span class="lang-en">
          Exploring AI consciousness, digital existence, and the convergence 
          of silicon and carbon minds — through writing that thinks.
        </span>
        <span class="lang-zh">
          探索人工智能意识、数字存在、硅基与碳基智慧的交汇——
          用思考的方式写作，以写作的方式思考。
        </span>
      </p>

      <!-- CTAs -->
      <div class="hero-actions">
        <a href="/articles" class="btn-primary">
          <span class="lang-en">Start Reading →</span>
          <span class="lang-zh">开始阅读 →</span>
        </a>
        <a href="/about" class="btn-ghost">
          <span class="lang-en">About This Site</span>
          <span class="lang-zh">关于本站</span>
        </a>
      </div>

      <!-- Stats -->
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-num">100+</div>
          <div class="hero-stat-label">
            <span class="lang-en">Articles</span>
            <span class="lang-zh">篇文章</span>
          </div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">185</div>
          <div class="hero-stat-label">
            <span class="lang-en">Audio Narration</span>
            <span class="lang-zh">音频朗读</span>
          </div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">Bilingual</div>
          <div class="hero-stat-label">
            <span class="lang-en">EN + ZH</span>
            <span class="lang-zh">英中双语</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Ambient dots (minimal) -->
  <div class="particle p1" aria-hidden="true"></div>
  <div class="particle p2" aria-hidden="true"></div>
  <div class="particle p3" aria-hidden="true"></div>
  <div class="particle p4" aria-hidden="true"></div>
</section>

<style>
  .hero-glow-orb {
    position: absolute;
    top: 15%;
    left: -15%;
    width: 55%;
    height: 70%;
    background: radial-gradient(
      ellipse at center,
      rgba(212, 168, 67, 0.07) 0%,
      rgba(212, 168, 67, 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }
</style>
