---
// HotArticles.astro — Clean white cards with color accent bars
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const hotPosts = posts
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return 0;
  })
  .slice(0, 5);

const catIcon: Record<string, string> = {
  'silicon-voice': '🧠',
  'tech-obs': '⚡',
  'future-lens': '🔭',
  'human-memo': '💡',
};

const catBarClass: Record<string, string> = {
  'silicon-voice': 'sv',
  'tech-obs': 'to',
  'future-lens': 'fl',
  'human-memo': 'hm',
};

function getCatBar(cat: string) { return catBarClass[cat] || 'def'; }

function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}
---

<section class="hot-articles">
  <div class="container-xl">
    <div class="section-header">
      <div class="section-title-group">
        <span class="section-icon">🔥</span>
        <h2 class="section-title">
          <span class="lang-zh">热门文章</span>
          <span class="lang-en">Hot Articles</span>
        </h2>
      </div>
      <a href="/articles" class="section-more">
        <span class="lang-zh">查看全部 →</span>
        <span class="lang-en">View All →</span>
      </a>
    </div>

    <div class="hot-articles-grid">
      {hotPosts.map((post, i) => {
        const icon = catIcon[post.data.category] || '📄';
        const barClass = getCatBar(post.data.category);
        return (
          <a href={`/articles/${post.id}`} class="hot-article-card">
            <div class={`hot-card-accent-bar ${barClass}`}></div>
            <div class="hot-card-cover">
              <div class="hot-card-icon-wrap">{icon}</div>
            </div>
            <div class="hot-card-body">
              <div class="hot-card-title">
                <span class="lang-zh">{post.data.titleZh || post.data.title}</span>
                <span class="lang-en">{post.data.title}</span>
              </div>
              <div class="hot-card-meta">
                <span class="hot-card-rank">#{i + 1}</span>
                <span>{icon}</span>
                <span>{fmtDate(post.data.pubDate)}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
