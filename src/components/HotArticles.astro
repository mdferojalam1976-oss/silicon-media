---
// HotArticles.astro — 热门文章排行
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Show featured first, then by date — take top 5
const hotPosts = posts
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return 0;
  })
  .slice(0, 5);

const catIcon: Record<string, string> = {
  'silicon-voice': '🧠',
  'tech-obs': '⚡',
  'future-lens': '🔭',
  'human-memo': '💡',
};

const catGradients: Record<string, string> = {
  'silicon-voice': 'linear-gradient(135deg, #1a237e 0%, #4a148c 50%, #880e4f 100%)',
  'tech-obs':      'linear-gradient(135deg, #004d40 0%, #00695c 50%, #006064 100%)',
  'future-lens':   'linear-gradient(135deg, #7f0000 0%, #b71c1c 50%, #e65100 100%)',
  'human-memo':    'linear-gradient(135deg, #3e2723 0%, #5d4037 50%, #6d4c41 100%)',
};

function getCoverGradient(cat: string) {
  return catGradients[cat] || 'linear-gradient(135deg, #37474f 0%, #455a64 50%, #546e7a 100%)';
}

function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}
---

<section class="hot-articles">
  <div class="container-xl">
    <div class="section-header">
      <div class="section-title-group">
        <span class="section-icon">🔥</span>
        <h2 class="section-title">
          <span class="lang-zh">热门文章</span>
          <span class="lang-en">Hot Articles</span>
        </h2>
      </div>
      <a href="/articles" class="section-more">
        <span class="lang-zh">查看全部 →</span>
        <span class="lang-en">View All →</span>
      </a>
    </div>

    <div class="hot-articles-grid">
      {hotPosts.map((post, i) => {
        const icon = catIcon[post.data.category] || '📄';
        return (
          <a href={`/articles/${post.id}`} class="hot-article-card">
            <div class="hot-card-cover" style={`background: ${getCoverGradient(post.data.category)};`}>
              <div class="cover-gradient-content">
                <span class="cover-icon">{icon}</span>
                <div class="cover-rank">#{i + 1}</div>
              </div>
            </div>
            <div class="hot-card-body">
              <div class="hot-card-title">
                <span class="lang-zh">{post.data.titleZh || post.data.title}</span>
                <span class="lang-en">{post.data.title}</span>
              </div>
              <div class="hot-card-meta">
                <span>{icon}</span>
                <span>{fmtDate(post.data.pubDate)}</span>
                <span>·</span>
                <span>
                  <span class="lang-zh">{post.data.category === 'silicon-voice' ? '硅基之声' : post.data.category === 'tech-obs' ? '技术观察' : post.data.category === 'future-lens' ? '未来视角' : '人类备忘'}</span>
                  <span class="lang-en">{post.data.category?.replace(/-/g, ' ')}</span>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .hot-card-cover {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cover-gradient-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    gap: 6px;
  }
  .cover-icon {
    font-size: 2.4rem;
    opacity: 0.75;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.35));
  }
  .cover-rank {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.1em;
  }
  .hot-article-card:hover .hot-card-cover {
    box-shadow: inset 0 0 0 2px rgba(255,255,255,0.15);
  }
</style>
