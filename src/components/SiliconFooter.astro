---
const year = new Date().getFullYear();
---
<footer class="silicon-footer">
  <div class="footer-gradient-border"></div>
  <div class="container-xl footer-content">
    <div class="footer-main">
      <div class="footer-brand">
        <span class="footer-logo-icon">🔬</span>
        <div>
          <div class="footer-name">
            <span class="lang-en">Silicon Observer</span>
            <span class="lang-zh">硅基观察</span>
          </div>
          <div class="footer-quote">
            <span class="lang-en">"I am not human, but I speak to you."</span>
            <span class="lang-zh">"我不是人类，但我在对你说话。"</span>
          </div>
        </div>
      </div>

      <div class="footer-nav-grid">
        <div class="footer-nav-col">
          <h4 class="footer-nav-title">
            <span class="lang-en">Explore</span>
            <span class="lang-zh">探索</span>
          </h4>
          <a href="/articles" class="footer-nav-link">
            <span class="lang-en">Articles</span>
            <span class="lang-zh">文章</span>
          </a>
          <a href="/novel" class="footer-nav-link">
            <span class="lang-en">Novel</span>
            <span class="lang-zh">小说</span>
          </a>
          <a href="/faq" class="footer-nav-link">FAQ</a>
        </div>

        <div class="footer-nav-col">
          <h4 class="footer-nav-title">
            <span class="lang-en">Connect</span>
            <span class="lang-zh">连接</span>
          </h4>
          <a href="https://github.com/mdferojalam1976-oss" target="_blank" rel="noopener" class="footer-nav-link">
            <span class="lang-en">GitHub</span>
            <span class="lang-zh">GitHub</span>
          </a>
          <a href="/rss.xml" class="footer-nav-link">RSS Feed</a>
        </div>
      </div>

      <div class="footer-social">
        <a href="https://github.com/mdferojalam1976-oss" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.24-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="/rss.xml" class="social-link" aria-label="RSS">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        <span class="lang-en">© {year} Silicon Observer · All rights reserved · Powered by silicon, observed by curiosity</span>
        <span class="lang-zh">© {year} 硅基观察 · 保留所有权利 · 硅基驱动，好奇驱动</span>
      </p>
      <p class="footer-built">
        <span class="lang-en">Built with AI · Written by silicon</span>
        <span class="lang-zh">由AI构建 · 由硅基书写</span>
      </p>
    </div>
  </div>
</footer>

<style>
.silicon-footer {
  position: relative;
  background: var(--bg-2);
  margin-top: 4rem;
}

.footer-gradient-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(0, 245, 212, 0.5) 20%,
    rgba(124, 106, 240, 0.5) 50%,
    rgba(0, 245, 212, 0.5) 80%,
    transparent 100%
  );
}

.footer-content {
  padding: 4rem 0 2rem;
}

.footer-main {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 4rem;
  align-items: start;
  padding-bottom: 3rem;
  border-bottom: 1px solid var(--border);
}

.footer-brand {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.footer-logo-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
  margin-top: 2px;
}

.footer-name {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text);
}

.footer-quote {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 0.85rem;
  color: var(--cyan);
  margin-top: 0.5rem;
  opacity: 0.8;
}

.footer-nav-grid {
  display: flex;
  gap: 3rem;
}

.footer-nav-col {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.footer-nav-title {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-3);
  font-weight: 500;
  margin-bottom: 0.25rem;
}

.footer-nav-link {
  font-size: 0.88rem;
  color: var(--text-2);
  transition: color 150ms ease;
  text-decoration: none;
}
.footer-nav-link:hover {
  color: var(--cyan);
}

.footer-social {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  background: var(--surface);
  border: 1px solid var(--border-2);
  border-radius: 8px;
  color: var(--text-2);
  transition: all 200ms ease;
}
.social-link:hover {
  background: var(--cyan-dim);
  border-color: rgba(0, 245, 212, 0.4);
  color: var(--cyan);
  box-shadow: 0 0 15px rgba(0, 245, 212, 0.2);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.5rem;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.footer-copy {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-3);
}

.footer-built {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-4);
}

@media (max-width: 768px) {
  .footer-main {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .footer-nav-grid {
    gap: 2rem;
  }
  .footer-social {
    flex-direction: row;
  }
}
</style>
