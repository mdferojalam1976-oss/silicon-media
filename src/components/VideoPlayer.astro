---
interface Props {
  /** Local video file path OR YouTube/remote URL */
  url?: string;
  /** Legacy prop for local files */
  src?: string;
  title: string;
  titleEn?: string;
  /** Compact mode for video listing cards */
  compact?: boolean;
}

const { url, src, title, titleEn, compact = false } = Astro.props;
const videoSrc = url || src || '';

// Detect YouTube
const isYouTube = /youtube\.com|youtu\.be|bilibili\.com/i.test(videoSrc);
const isDirect = !isYouTube && (videoSrc.endsWith('.mp4') || videoSrc.endsWith('.webm') || videoSrc.startsWith('/'));

// YouTube embed ID extraction
let youtubeId = '';
if (isYouTube) {
  const match = videoSrc.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/)
    || videoSrc.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]+)/)
    || videoSrc.match(/bilibili\.com\/video\/(BV[a-zA-Z0-9]+)/);
  if (match) {
    youtubeId = match[1];
    // Bilibili embed
    if (videoSrc.includes('bilibili.com')) {
      youtubeId = `bilibili:${match[1]}`;
    }
  }
}
---

<div class:list={["video-player", { compact }]} data-src={videoSrc} data-yt={youtubeId || ''}>
  {isYouTube ? (
    // YouTube / Bilibili embed
    <div class="video-embed-container">
      {youtubeId.startsWith('bilibili:') ? (
        <iframe
          src={`https://player.bilibili.com/player.html?bvid=${youtubeId.replace('bilibili:', '')}&autoplay=0`}
          allowfullscreen
          scrolling="no"
          frameborder="0"
          sandbox="allow-scripts allow-same-origin allow-popups"
          title={title}
        ></iframe>
      ) : (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0&modestbranding=1`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          title={title}
        ></iframe>
      )}
    </div>
  ) : isDirect ? (
    // Local / direct video file with lazy load
    <div class="video-header">
      <span class="video-icon">🎬</span>
      <span class="video-label">
        <span class="video-label-zh">视频版</span>
        <span class="video-label-en" style="display:none">Video Version</span>
      </span>
      <button class="play-video-btn" aria-label="播放视频">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </button>
    </div>
    <div class="video-container" style="display:none">
      <video controls playsinline preload="metadata">
        <source src={videoSrc} type="video/mp4" />
        您的浏览器不支持视频播放。
      </video>
    </div>
  ) : (
    // Fallback: direct embed or link
    <div class="video-header">
      <span class="video-icon">🎬</span>
      <a href={videoSrc} target="_blank" rel="noopener" class="video-label video-link">
        <span class="video-label-zh">观看视频 →</span>
        <span class="video-label-en" style="display:none">Watch Video →</span>
      </a>
    </div>
  )}
</div>

<style>
  .video-player {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }
  .video-player.compact {
    border-radius: 10px;
  }

  /* Embed (YouTube/Bilibili) */
  .video-embed-container {
    position: relative;
    background: #000;
    aspect-ratio: 16/9;
  }
  .video-embed-container iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Lazy load header */
  .video-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
  }
  .video-icon { font-size: 1.2rem; }
  .video-label {
    flex: 1;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  .video-link {
    color: var(--cyan);
    text-decoration: none;
  }
  .video-link:hover { text-decoration: underline; }

  .play-video-btn {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--cyan);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0c0c0e;
    transition: all 0.2s ease;
  }
  .play-video-btn:hover {
    background: #00e8dc;
    transform: scale(1.05);
    box-shadow: 0 0 20px rgba(0, 245, 212, 0.3);
  }
  .play-video-btn svg { width: 16px; height: 16px; }

  .video-container {
    background: #000;
  }
  .video-container video {
    width: 100%;
    max-height: 500px;
    display: block;
  }
  .compact .video-container video {
    max-height: 240px;
  }

  /* Article media section label */
  :global(.article-media-section) {
    margin: 2rem 0;
  }
  :global(.media-label) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 0.75rem;
  }
  :global(.media-duration) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-3);
    margin-top: 0.5rem;
  }
  :global(.audio-placeholder) {
    padding: 1.5rem;
    text-align: center;
    color: var(--text-3);
    font-size: 0.9rem;
    background: var(--surface);
    border-radius: 10px;
    border: 1px dashed var(--border-2);
  }
</style>

<script>
  // Lazy load video player
  document.querySelectorAll('.video-player:not(.compact)').forEach(player => {
    const el = player as HTMLElement;
    const header = el.querySelector('.video-header') as HTMLElement;
    const container = el.querySelector('.video-container') as HTMLElement;
    const video = el.querySelector('video') as HTMLVideoElement;
    const playBtn = el.querySelector('.play-video-btn') as HTMLButtonElement;

    if (header && container) {
      header.addEventListener('click', () => {
        const isHidden = container.style.display === 'none' || !container.style.display;
        container.style.display = isHidden ? 'block' : 'none';
        if (isHidden && video) video.play();
      });
    }
  });

  // Language sync
  document.querySelectorAll('.lang-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = (btn as HTMLElement).dataset.lang;
      document.querySelectorAll('.video-label-zh').forEach(el => (el as HTMLElement).style.display = lang === 'en' ? 'none' : '');
      document.querySelectorAll('.video-label-en').forEach(el => (el as HTMLElement).style.display = lang === 'en' ? '' : 'none');
    });
  });
</script>
