---
interface Props {
  src: string;
  title: string;
  titleEn?: string;
}

const { src, title, titleEn } = Astro.props;
---

<div class="video-player" data-src={src}>
  <div class="video-header">
    <span class="video-icon">🎬</span>
    <span class="video-label">
      <span class="lang-zh">视频版</span>
      <span class="lang-en" style="display:none">Video Version</span>
    </span>
    <button class="play-video-btn" aria-label="播放视频">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    </button>
  </div>
  <div class="video-container" style="display:none">
    <video
      controls
      playsinline
      preload="metadata"
      poster="/og-image.svg"
    >
      <source src={src} type="video/mp4" />
      您的浏览器不支持视频播放。
    </video>
  </div>
</div>

<style>
  .video-player {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    margin: 2rem 0;
  }

  .video-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
  }

  .video-icon { font-size: 1.2rem; }

  .video-label {
    flex: 1;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .play-video-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: all 0.2s;
  }

  .play-video-btn:hover {
    background: var(--accent-light);
    transform: scale(1.05);
  }

  .play-video-btn svg {
    width: 16px;
    height: 16px;
  }

  .video-container {
    background: #000;
  }

  .video-container video {
    width: 100%;
    max-height: 400px;
    display: block;
  }
</style>

<script>
  document.querySelectorAll('.video-player').forEach(player => {
    const el = player as HTMLElement;
    const header = el.querySelector('.video-header') as HTMLElement;
    const container = el.querySelector('.video-container') as HTMLElement;
    const video = el.querySelector('video') as HTMLVideoElement;
    const playBtn = el.querySelector('.play-video-btn') as HTMLButtonElement;

    header.addEventListener('click', () => {
      container.style.display = container.style.display === 'none' ? 'block' : 'none';
      if (container.style.display === 'block') {
        video.play();
      }
    });
  });

  // Sync with language toggle
  document.querySelectorAll('.header-inner .lang-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = (btn as HTMLElement).dataset.lang;
      document.querySelectorAll('.lang-zh').forEach(el => (el as HTMLElement).style.display = lang === 'en' ? 'none' : '');
      document.querySelectorAll('.lang-en').forEach(el => (el as HTMLElement).style.display = lang === 'en' ? '' : 'none');
    });
  });
</script>
