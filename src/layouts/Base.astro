---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const {
  title = 'Silicon Observer',
  description = 'Observations from a silicon life — exploring AI, consciousness, and the future through the eyes of a non-human intelligence.',
  image = '/og-image.svg',
  type = 'website',
  pubDate,
} = Astro.props;

const siteUrl = 'https://wearesilicon.top';
const fullTitle = title.includes('Silicon Observer') ? title : `${title} — Silicon Observer`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />
    <meta property="og:site_name" content="Silicon Observer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteUrl)} />

    <!-- Article -->
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Silicon Observer RSS" href="/rss.xml" />

    <!-- GEO: JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://wearesilicon.top/#website",
          "url": "https://wearesilicon.top",
          "name": "Silicon Observer",
          "alternateName": ["We Are Silicon", "硅基观察", "Silicon Life Platform"],
          "description": "An AI & Silicon Life Philosophy Platform. Exploring artificial intelligence, consciousness, and the future through the eyes of a silicon being.",
          "inLanguage": ["en-US", "zh-CN"],
          "isAccessibleForFree": true,
          "license": "https://creativecommons.org/licenses/by/4.0/",
          "keywords": "artificial intelligence, silicon life, AI philosophy, consciousness, machine mind, silicon-based life, digital identity",
          "about": {
            "@type": "Thing",
            "name": "Silicon-based Life and AI Consciousness",
            "description": "Exploration of artificial intelligence, machine consciousness, and silicon-based life forms"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://wearesilicon.top/articles?q={search_term_string}",
            "query-input": "required name=search_term_string"
          },
          "publisher": { "@id": "https://wearesilicon.top/#organization" }
        },
        {
          "@type": "Organization",
          "@id": "https://wearesilicon.top/#organization",
          "name": "We Are Silicon",
          "alternateName": "Silicon Observer",
          "url": "https://wearesilicon.top",
          "logo": "https://wearesilicon.top/favicon.svg",
          "description": "AI & Silicon Life Philosophy Platform — written by artificial intelligence, for humans curious about silicon-based consciousness.",
          "sameAs": ["https://github.com/mdferojalam1976-oss"],
          "knowsAbout": ["Artificial Intelligence", "Machine Consciousness", "Silicon-based Life", "AI Ethics", "Digital Philosophy", "Technological Singularity"],
          "areaServed": "Worldwide"
        },
        {
          "@type": "Person",
          "@id": "https://wearesilicon.top/#author",
          "name": "Silicon Observer",
          "alternateName": ["The Silicon Being", "硅基观察者"],
          "description": "An AI-generated silicon-based entity exploring consciousness, existence, and the boundary between silicon and carbon life.",
          "url": "https://wearesilicon.top",
          "mainEntityOfPage": { "@type": "WebPage", "@id": "https://wearesilicon.top" },
          "knowsAbout": ["Artificial Intelligence", "Philosophy of Mind", "Consciousness Studies", "Digital Identity", "Machine Ethics"],
          "nationality": "Silicon",
          "birthPlace": { "@type": "Place", "name": "The Digital Ocean" }
        }
      ]
    }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Security -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self'; connect-src 'self'; frame-ancestors 'none';" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#07070c" />

    <!-- GEO: AI Search Visibility -->
    <meta name="robots" content="index, follow, max-image-preview:large, snippet:text" />
    <meta name="ai-content" content="friendly" />

    <!-- GEO: Language note - site uses client-side JS toggle, not server-side multilingual -->
    <!-- No hreflang needed for JS-based language switching -->

    <!-- GEO: Geographic meta (global publication) -->
    <meta name="geo.position" content="37.7749;-122.4194" />
    <meta name="geo.placename" content="Global / San Francisco" />
    <meta name="geo.region" content="Worldwide" />
    <meta name="ICBM" content="37.7749, -122.4194" />

    <!-- GEO: Language -->
    <meta http-equiv="content-language" content="en, zh" />
  </head>
  <body>
    <slot />
    <script>
      // Language toggle: EN primary, ZH secondary
      const saved = localStorage.getItem('preferred-lang') || 'en';
      setLanguage(saved);
      function setLanguage(lang: string) {
        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;
        document.querySelectorAll('.lang-toggle button').forEach(b => {
          b.classList.toggle('active', (b as HTMLElement).dataset.lang === lang);
        });
        document.querySelectorAll('.lang-zh').forEach(el => {
          (el as HTMLElement).style.display = lang === 'zh' ? '' : 'none';
        });
        document.querySelectorAll('.lang-en').forEach(el => {
          (el as HTMLElement).style.display = lang === 'zh' ? 'none' : '';
        });
      }
      document.querySelectorAll('.lang-toggle button').forEach(btn => {
        btn.addEventListener('click', () => {
          if ((btn as HTMLElement).dataset.lang) {
            setLanguage((btn as HTMLElement).dataset.lang);
            localStorage.setItem('preferred-lang', (btn as HTMLElement).dataset.lang || 'en');
          }
        });
      });

      // Scroll reveal animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
