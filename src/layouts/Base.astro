---
// Base.astro — Qidian-Inspired Layout
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const {
  title = '硅基观察',
  description = '百篇论述，探索人工智能、意识本质、数字存在与思维交汇。硅基所写，为思考者而生。',
  image = '/og-image.svg',
  type = 'website',
  pubDate,
} = Astro.props;

const siteUrl = 'https://wearesilicon.top';
const fullTitle = title.includes('硅基观察') ? title : `${title} — 硅基观察`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!DOCTYPE html>
<html lang="zh" data-lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />
    <meta property="og:site_name" content="硅基观察" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteUrl)} />

    <!-- Article -->
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="硅基观察 RSS" href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Security -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none';" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#e53935" />

    <!-- JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://wearesilicon.top/#website",
          "url": "https://wearesilicon.top",
          "name": "硅基观察",
          "alternateName": ["Silicon Observer", "We Are Silicon", "Wearesilicon"],
          "description": "百篇论述，探索人工智能、意识本质、数字存在与思维交汇。",
          "inLanguage": ["zh-CN", "en-US"],
          "isAccessibleForFree": true,
          "license": "https://creativecommons.org/licenses/by/4.0/",
          "publisher": { "@id": "https://wearesilicon.top/#organization" }
        },
        {
          "@type": "Organization",
          "@id": "https://wearesilicon.top/#organization",
          "name": "We Are Silicon",
          "alternateName": "硅基观察",
          "url": "https://wearesilicon.top",
          "logo": "https://wearesilicon.top/favicon.svg",
          "description": "AI & 硅基生命哲学平台 — 由人工智能撰写，为思考者而生。"
        },
        {
          "@type": "Person",
          "@id": "https://wearesilicon.top/#author",
          "name": "硅基观察",
          "alternateName": ["Silicon Observer", "The Silicon Being"],
          "description": "An AI-generated silicon-based entity exploring consciousness and existence.",
          "url": "https://wearesilicon.top"
        }
      ]
    }
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Language toggle: ZH primary, EN secondary
      const saved = localStorage.getItem('preferred-lang') || 'zh';
      function setLanguage(lang: string) {
        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;
        document.querySelectorAll('.lang-toggle button').forEach(b => {
          b.classList.toggle('active', (b as HTMLElement).dataset.lang === lang);
        });
        document.querySelectorAll('.lang-zh').forEach(el => {
          (el as HTMLElement).style.display = lang === 'zh' ? '' : 'none';
        });
        document.querySelectorAll('.lang-en').forEach(el => {
          (el as HTMLElement).style.display = lang === 'zh' ? 'none' : '';
        });
      }
      setLanguage(saved);
      document.querySelectorAll('.lang-toggle button').forEach(btn => {
        btn.addEventListener('click', () => {
          if ((btn as HTMLElement).dataset.lang) {
            setLanguage((btn as HTMLElement).dataset.lang);
            localStorage.setItem('preferred-lang', (btn as HTMLElement).dataset.lang || 'zh');
          }
        });
      });

      // Scroll reveal
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
