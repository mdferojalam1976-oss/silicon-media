---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/SiliconFooter.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content } = await render(post);

const catMeta: Record<string, { label: string; labelZh: string; icon: string; color: string }> = {
  'silicon-voice': { label: 'Silicon Voice', labelZh: '硅基之声', icon: '🧠', color: 'silicon-voice' },
  'tech-obs':      { label: 'Tech Observer',  labelZh: '技术观察',  icon: '⚡', color: 'tech-obs' },
  'future-lens':   { label: 'Future Lens',    labelZh: '未来视角',  icon: '🔭', color: 'future-lens' },
  'human-memo':    { label: 'Human Memo',     labelZh: '人类备忘',  icon: '💡', color: 'human-memo' },
};
const cat = catMeta[post.data.category] || catMeta['silicon-voice'];

function fmt(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
function fmtZh(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}

const siteUrl = 'https://wearesilicon.top';
const articleUrl = new URL(Astro.url.pathname, siteUrl).href;
const categoryLabels: Record<string, string> = {
  'silicon-voice': 'Silicon Voice',
  'tech-obs': 'Tech Observer',
  'future-lens': 'Future Lens',
  'human-memo': 'Human Memo',
};
const category = categoryLabels[post.data.category] || 'Article';
const tags = post.data.tags || [];

// JSON-LD data for article
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.titleEn || post.data.title,
  "description": post.data.descriptionEn || post.data.description,
  "inLanguage": post.data.lang === 'zh' ? 'zh-CN' : 'en-US',
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "url": articleUrl,
  "author": { "@id": "https://wearesilicon.top/#author" },
  "publisher": { "@id": "https://wearesilicon.top/#organization" },
  "image": { "@type": "ImageObject", "url": post.data.coverImage || `${siteUrl}/og-image.svg` },
  "articleSection": category,
  "keywords": tags.join(', '),
  "wordCount": 800,
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "isAccessibleForFree": true,
  "mainEntityOfPage": { "@type": "WebPage", "@id": articleUrl }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Articles", "item": `${siteUrl}/articles` },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": articleUrl }
  ]
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.coverImage}
  type="article"
  pubDate={post.data.pubDate}
>

  <!-- GEO: Article BlogPosting Schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(blogPostingSchema)} />

  <!-- GEO: Breadcrumb Schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main class="article-page">
    <div class="container">
      <!-- Hero -->
      <header class="article-hero">
        <div class="article-hero-meta">
          <span class={`card-category ${cat.color}`}>
            <span class="lang-en">{cat.icon} {cat.label}</span>
            <span class="lang-zh">{cat.icon} {cat.labelZh}</span>
          </span>
          <span class="article-hero-date">
            <span class="lang-en">{fmt(post.data.pubDate)}</span>
            <span class="lang-zh">{fmtZh(post.data.pubDate)}</span>
          </span>
        </div>

        <h1 class="article-hero-title">
          <span class="lang-en">{post.data.title}</span>
          <span class="lang-zh">{post.data.titleZh || post.data.title}</span>
          {post.data.titleEn && (
            <small>
              <span class="lang-en">{post.data.titleEn}</span>
            </small>
          )}
        </h1>

        <p class="article-hero-desc">
          <span class="lang-en">{post.data.description}</span>
          <span class="lang-zh">{post.data.descriptionZh || post.data.description}</span>
        </p>
        {post.data.descriptionEn && (
          <p class="article-hero-desc-en">
            <span class="lang-en">{post.data.descriptionEn}</span>
          </p>
        )}
      </header>

      <!-- Multimedia: Video -->
      {post.data.videoUrl && (
        <div class="article-media-section">
          <div class="media-label">
            <span class="lang-en">🎬 Video</span>
            <span class="lang-zh">🎬 视频</span>
          </div>
          <VideoPlayer url={post.data.videoUrl} title={post.data.title} />
          {post.data.videoDuration && (
            <span class="media-duration">{post.data.videoDuration}</span>
          )}
        </div>
      )}

      <!-- Multimedia: Audio -->
      {(post.data.audioUrl || post.data.lang === 'bilingual') && (
        <div class="audio-section">
          <div class="media-label">
            <span class="lang-en">🎧 Audio Narration</span>
            <span class="lang-zh">🎧 音频朗读</span>
          </div>
          {post.data.audioUrl ? (
            <AudioPlayer url={post.data.audioUrl} title={post.data.title} />
          ) : (
            <div class="audio-placeholder">
              <p>
                <span class="lang-en">Audio narration coming soon for this article.</span>
                <span class="lang-zh">本文音频朗读即将上线。</span>
              </p>
            </div>
          )}
        </div>
      )}

      <!-- Body -->
      <article class="article-body">
        <Content />
      </article>

      <!-- Back nav -->
      <nav style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 0.8rem;">
        <a href="/articles" style="color: var(--text-3); transition: color 150ms ease;" onmouseover="this.style.color='var(--cyan)'" onmouseout="this.style.color='var(--text-3)'">
          <span class="lang-en">← Back to Articles</span>
          <span class="lang-zh">← 返回文章列表</span>
        </a>
        <a href="/" style="color: var(--text-3); transition: color 150ms ease;" onmouseover="this.style.color='var(--cyan)'" onmouseout="this.style.color='var(--text-3)'">
          <span class="lang-en">← Home</span>
          <span class="lang-zh">← 首页</span>
        </a>
      </nav>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .audio-section {
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .audio-toggle { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .audio-tab {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--border-2);
    border-radius: 99px;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    transition: all var(--t-fast) var(--ease);
  }
  .audio-tab:hover { border-color: var(--cyan); color: var(--text-2); }
  .audio-tab.active { background: var(--violet); border-color: var(--violet); color: #fff; }
</style>

<script>
  // Audio language toggle
  document.querySelectorAll('.audio-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = (btn as HTMLElement).dataset.lang;
      document.querySelectorAll('.audio-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.audio-zh').forEach(el => (el as HTMLElement).style.display = lang === 'en' ? 'none' : '');
      document.querySelectorAll('.audio-en').forEach(el => (el as HTMLElement).style.display = lang === 'en' ? '' : 'none');
    });
  });
</script>
