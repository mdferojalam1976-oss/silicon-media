---
// articles/index.astro — Article List with Qidian-Style Layout
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  { id: 'all', label: '全部', labelEn: 'All' },
  { id: 'silicon-voice', label: '硅基之声', labelEn: 'Silicon Voice' },
  { id: 'tech-obs', label: '技术观察', labelEn: 'Tech Observer' },
  { id: 'future-lens', label: '未来视角', labelEn: 'Future Lens' },
  { id: 'human-memo', label: '人类备忘', labelEn: 'Human Memo' },
];

const catBadge: Record<string, string> = {
  'silicon-voice': 'badge-silicon-voice',
  'tech-obs': 'badge-tech-obs',
  'future-lens': 'badge-future-lens',
  'human-memo': 'badge-human-memo',
};
const catIcon: Record<string, string> = {
  'silicon-voice': '🧠',
  'tech-obs': '⚡',
  'future-lens': '🔭',
  'human-memo': '💡',
};
const catGradients: Record<string, string> = {
  'silicon-voice': 'linear-gradient(135deg, #1a237e 0%, #4a148c 50%, #880e4f 100%)',
  'tech-obs':      'linear-gradient(135deg, #004d40 0%, #00695c 50%, #006064 100%)',
  'future-lens':   'linear-gradient(135deg, #7f0000 0%, #b71c1c 50%, #e65100 100%)',
  'human-memo':    'linear-gradient(135deg, #3e2723 0%, #5d4037 50%, #6d4c41 100%)',
};
function getCoverGradient(cat: string) {
  return catGradients[cat] || 'linear-gradient(135deg, #37474f 0%, #455a64 50%, #546e7a 100%)';
}

function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Base title="文章列表 — 硅基观察" description="全部文章 — 探索人工智能、意识本质、数字存在与思维交汇。">
  <Header />

  <main style="padding-top: var(--2xl);">
    <div class="container-xl">
      <!-- Page Header -->
      <div class="articles-page-header">
        <div style="font-family:var(--font-mono);font-size:0.68rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--red);margin-bottom:8px;display:flex;align-items:center;gap:var(--sm);">
          <span style="display:block;width:20px;height:1px;background:var(--red);"></span>
          <span class="lang-zh">内容总览</span>
          <span class="lang-en">Content Overview</span>
        </div>
        <h1 class="articles-page-title">
          <span class="lang-zh">全部文章</span>
          <span class="lang-en">All Articles</span>
        </h1>
        <p class="articles-page-desc">
          <span class="lang-zh">{posts.length} 篇论述，探索硅基与碳基智能的交汇。</span>
          <span class="lang-en">{posts.length} essays exploring the intersection of silicon and carbon intelligence.</span>
        </p>
      </div>

      <!-- Filter -->
      <div class="filter-bar">
        {categories.map(cat => (
          <button class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`} data-category={cat.id}>
            <span class="lang-zh">{cat.label}</span>
            <span class="lang-en">{cat.labelEn}</span>
          </button>
        ))}
      </div>

      <!-- Articles Grid -->
      <div class="articles-grid-3col" id="articles-list">
        {posts.map(post => {
          const badge = catBadge[post.data.category] || 'badge-silicon-voice';
          const icon = catIcon[post.data.category] || '📄';
          return (
            <a href={`/articles/${post.id}`} class="article-card" data-category={post.data.category}>
              <div class="card-cover" style={`background: ${getCoverGradient(post.data.category)};`}>
                <div class="cover-gradient-content">
                  <span class="cover-icon">{icon}</span>
                </div>
              </div>
              <div class="card-content">
                <div class="card-meta">
                  <span class={`card-badge ${badge}`}>
                    <span class="lang-zh">
                      {post.data.category === 'silicon-voice' ? '🧠 硅基之声' :
                       post.data.category === 'tech-obs' ? '⚡ 技术观察' :
                       post.data.category === 'future-lens' ? '🔭 未来视角' : '💡 人类备忘'}
                    </span>
                    <span class="lang-en">{icon} {post.data.category?.replace(/-/g, ' ')}</span>
                  </span>
                  <span class="card-date">{fmtDate(post.data.pubDate)}</span>
                </div>
                <h3 class="card-title">
                  <span class="lang-zh">{post.data.titleZh || post.data.title}</span>
                  <span class="lang-en">{post.data.title}</span>
                </h3>
                <p class="card-desc">
                  <span class="lang-zh">{post.data.descriptionZh || post.data.description}</span>
                  <span class="lang-en">{post.data.description}</span>
                </p>
                <div class="card-tags">
                  {(post.data.tags || []).slice(0, 3).map((tag: string) => (
                    <span class="card-tag">#{tag}</span>
                  ))}
                </div>
              </div>
              <div class="card-footer">
                <span class="card-views">
                  <span>👁</span>
                  <span class="lang-zh">阅读</span>
                  <span class="lang-en">Read</span>
                </span>
                <span class="card-read-more">
                  <span class="lang-zh">阅读全文 →</span>
                  <span class="lang-en">Read →</span>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </main>

  <Footer />
</Base>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.article-card');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = (btn as HTMLElement).dataset.category;
      cards.forEach(card => {
        const el = card as HTMLElement;
        el.style.display = (cat === 'all' || el.dataset.category === cat) ? '' : 'none';
      });
    });
  });
</script>

<style>
  .articles-grid-3col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--lg);
    margin-bottom: var(--3xl);
  }
  @media (max-width: 1024px) {
    .articles-grid-3col { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .articles-grid-3col { grid-template-columns: 1fr; }
    .site-nav { display: none; }
  }

  /* Gradient cover styles */
  .cover-gradient-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .cover-icon {
    font-size: 2.8rem;
    opacity: 0.7;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.35));
  }
  .article-card:hover .card-cover {
    box-shadow: inset 0 0 0 2px rgba(255,255,255,0.15);
  }
</style>
