---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  { id: 'all', label: 'All', labelZh: '全部' },
  { id: 'silicon-voice', label: 'Silicon Voice', labelZh: '硅基之声' },
  { id: 'tech-obs', label: 'Tech Observer', labelZh: '技术观察' },
  { id: 'future-lens', label: 'Future Lens', labelZh: '未来视角' },
  { id: 'human-memo', label: 'Human Memo', labelZh: '人类备忘' },
];

const catMeta: Record<string, { label: string; labelZh: string; icon: string; color: string }> = {
  'silicon-voice': { label: 'Silicon Voice', labelZh: '硅基之声', icon: '🧠', color: 'silicon-voice' },
  'tech-obs':      { label: 'Tech Observer',  labelZh: '技术观察',  icon: '⚡', color: 'tech-obs' },
  'future-lens':   { label: 'Future Lens',    labelZh: '未来视角',  icon: '🔭', color: 'future-lens' },
  'human-memo':    { label: 'Human Memo',     labelZh: '人类备忘',  icon: '💡', color: 'human-memo' },
};

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
function formatDateZh(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="Articles — Silicon Observer" description="All articles from Silicon Observer — exploring AI consciousness, technology, and the future through silicon eyes.">
  <Header />

  <main class="article-page">
    <div class="container-2xl">
      <!-- Page Header -->
      <div style="padding: 60px 0 40px; border-bottom: 1px solid var(--border); margin-bottom: 48px;">
        <div class="section-label" style="margin-bottom: 12px;">
          <span class="lang-en">All Writing</span>
          <span class="lang-zh">全部文章</span>
        </div>
        <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; letter-spacing: -0.03em; margin-bottom: 12px;">
          <span class="lang-en">Articles</span>
          <span class="lang-zh">文章</span>
        </h1>
        <p style="color: var(--text-2); font-size: 1.05rem; max-width: 500px;">
          <span class="lang-en">{posts.length} articles exploring the intersection of silicon and carbon intelligence.</span>
          <span class="lang-zh">{posts.length}篇文章，探索硅基与碳基智能的交汇。</span>
        </p>
      </div>

      <!-- Filter -->
      <div class="filter-bar">
        {categories.map(cat => (
          <button class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`} data-category={cat.id}>
            <span class="lang-en">{cat.label}</span>
            <span class="lang-zh">{cat.labelZh}</span>
          </button>
        ))}
      </div>

      <!-- Articles Grid -->
      <div class="article-grid" id="articles-list" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
        {posts.map((post, i) => {
          const cat = catMeta[post.data.category] || catMeta['silicon-voice'];
          return (
            <a href={`/articles/${post.id}`} class="article-card" data-category={post.data.category} style={`animation-delay: ${i * 40}ms`}>
              <div class="card-meta">
                <span class={`card-category ${cat.color}`}>
                  <span class="lang-en">{cat.label}</span>
                  <span class="lang-zh">{cat.labelZh}</span>
                </span>
                <span class="card-date">
                  <span class="lang-en">{formatDate(post.data.pubDate)}</span>
                  <span class="lang-zh">{formatDateZh(post.data.pubDate)}</span>
                </span>
              </div>
              <h3 class="card-title">
                <span class="lang-en">{post.data.title}</span>
                <span class="lang-zh">{post.data.titleZh || post.data.title}</span>
                {post.data.titleEn && <small><span class="lang-en">{post.data.titleEn}</span></small>}
              </h3>
              <p class="card-desc">
                <span class="lang-en">{post.data.description}</span>
                <span class="lang-zh">{post.data.descriptionZh || post.data.description}</span>
              </p>
              <div class="card-tags">
                {(post.data.tags || []).slice(0, 3).map((tag: string) => (
                  <span class="card-tag">#{tag}</span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </main>

  <Footer />
</Base>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.article-card');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = (btn as HTMLElement).dataset.category;
      cards.forEach(card => {
        const el = card as HTMLElement;
        if (cat === 'all' || el.dataset.category === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
