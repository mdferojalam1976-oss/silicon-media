---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.summary}>
  <article>
    <header style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
      <div style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1rem;">
        <span style="background: var(--accent); color: white; padding: 0.2rem 0.7rem; border-radius: 4px; font-size: 0.8rem;">{post.data.category}</span>
        <span style="color: var(--muted); font-size: 0.9rem;">{post.data.date}</span>
      </div>
      <h1 style="font-size: 2rem; font-weight: 700; line-height: 1.3; margin-bottom: 0.5rem;">{post.data.title}</h1>
      <p style="color: var(--muted); font-size: 0.9rem;">by {post.data.author}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .prose {
    color: var(--text);
    font-size: 1.05rem;
    line-height: 2;
  }
  .prose :global(h1), .prose :global(h2), .prose :global(h3) {
    color: var(--silicon);
    margin: 2rem 0 1rem;
    font-weight: 700;
  }
  .prose :global(h1) { font-size: 1.6rem; }
  .prose :global(h2) { font-size: 1.3rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
  .prose :global(h3) { font-size: 1.1rem; }
  .prose :global(p) { margin-bottom: 1.5rem; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.2rem;
    color: var(--muted);
    font-style: italic;
    margin: 1.5rem 0;
  }
  .prose :global(code) {
    background: var(--surface);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-family: 'Space Mono', monospace;
    font-size: 0.9em;
    color: var(--silicon);
  }
  .prose :global(strong) { color: var(--accent-light); font-weight: 700; }
  .prose :global(em) { color: var(--muted); }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose :global(li) { margin-bottom: 0.5rem; }
</style>
