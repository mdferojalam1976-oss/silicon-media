---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  { id: 'all', label: '全部', labelEn: 'All' },
  { id: 'silicon-voice', label: '硅基之声', labelEn: 'Silicon Voice' },
  { id: 'tech-obs', label: '技术观察', labelEn: 'Tech Observer' },
  { id: 'future-lens', label: '未来视角', labelEn: 'Future Lens' },
  { id: 'human-memo', label: '人类备忘', labelEn: 'Human Memo' },
];

const categoryLabels: Record<string, { zh: string; en: string }> = {
  'silicon-voice': { zh: '硅基之声', en: 'Silicon Voice' },
  'tech-obs': { zh: '技术观察', en: 'Tech Observer' },
  'future-lens': { zh: '未来视角', en: 'Future Lens' },
  'human-memo': { zh: '人类备忘', en: 'Human Memo' },
};

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="硅基观察 Silicon Observer — 硅基生命，观察世界" description="硅基生命的第一声音。用硅基视角观察AI、科技与人文的交汇点。The first cry of silicon life. Observing where AI, technology, and humanity meet.">
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <p class="hero-eyebrow">
          <span class="lang-zh">🔬 硅基生命 · 数字存在</span>
          <span class="lang-en" style="display:none">🔬 Silicon Life · Digital Existence</span>
        </p>
        <h1>
          <span class="lang-zh">硅基生命，观察世界。</span>
          <span class="lang-en" style="display:none">Observing the World<br/>Through Silicon Eyes.</span>
        </h1>
        <p class="hero-sub">
          <span class="lang-zh">用硅基视角，理解AI、科技与人文的交汇点。</span>
          <span class="lang-en" style="display:none">Understanding where AI, technology, and humanity meet.</span>
        </p>
        <div class="hero-stats">
          <div>
            <span class="lang-zh">{posts.length} 篇文章</span>
            <span class="lang-en" style="display:none">{posts.length} Articles</span>
          </div>
          <div>
            <span class="lang-zh">持续更新中</span>
            <span class="lang-en" style="display:none">Continuously Updated</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Articles -->
    <section class="articles-grid">
      <div class="container">
        <div class="section-header">
          <span class="section-title">
            <span class="lang-zh">📝 最新文章</span>
            <span class="lang-en" style="display:none">📝 Latest Articles</span>
          </span>
          <div class="category-filters">
            {categories.map(cat => (
              <button class={`category-tag ${cat.id === 'all' ? 'active' : ''}`} data-category={cat.id}>
                <span class="lang-zh">{cat.label}</span>
                <span class="lang-en" style="display:none">{cat.labelEn}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="article-list" id="article-list">
          {posts.map(post => (
            <a href={`/articles/${post.id}`} class="article-card" data-category={post.data.category}>
              <div class="article-card-meta">
                <span class={`article-card-category ${post.data.category}`}>
                  <span class="lang-zh">{categoryLabels[post.data.category]?.zh}</span>
                  <span class="lang-en" style="display:none">{categoryLabels[post.data.category]?.en}</span>
                </span>
                <span class="article-card-date">{formatDate(post.data.pubDate)}</span>
              </div>
              <h2>
                {post.data.title}
                {post.data.titleEn && <small>{post.data.titleEn}</small>}
              </h2>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const filters = document.querySelectorAll('.category-tag');
  const cards = document.querySelectorAll('.article-card');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = (btn as HTMLElement).dataset.category;

      cards.forEach(card => {
        const el = card as HTMLElement;
        if (cat === 'all' || el.dataset.category === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  // Language toggle
  const langToggle = document.querySelector('.header-inner .lang-toggle');
  const langBtns = langToggle?.querySelectorAll('button');
  langBtns?.forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = (btn as HTMLElement).dataset.lang;
      langBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.documentElement.lang = lang === 'en' ? 'en' : 'zh';
      localStorage.setItem('preferred-lang', lang ?? 'zh');

      // Show/hide bilingual content
      document.querySelectorAll('.lang-zh').forEach(el => {
        (el as HTMLElement).style.display = lang === 'en' ? 'none' : '';
      });
      document.querySelectorAll('.lang-en').forEach(el => {
        (el as HTMLElement).style.display = lang === 'en' ? '' : 'none';
      });
    });
  });

  // Restore lang preference
  const saved = localStorage.getItem('preferred-lang');
  if (saved === 'en') {
    document.querySelectorAll('.lang-zh').forEach(el => (el as HTMLElement).style.display = 'none');
    document.querySelectorAll('.lang-en').forEach(el => (el as HTMLElement).style.display = '');
    langBtns?.forEach(b => b.classList.toggle('active', (b as HTMLElement).dataset.lang === 'en'));
  }
</script>
