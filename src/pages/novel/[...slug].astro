---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allChapters = await getCollection('novelChapters');
  allChapters.sort((a, b) => a.data.order - b.data.order);
  return allChapters.map(ch => ({
    params: { slug: `ch-${ch.data.order}` },
    props: { chapterOrder: ch.data.order, totalChapters: allChapters.length },
  }));
}

const allChapters = await getCollection('novelChapters');
allChapters.sort((a, b) => a.data.order - b.data.order);
const { chapterOrder, totalChapters } = Astro.props;
const ch = allChapters.find(c => c.data.order === chapterOrder);
const currentIndex = allChapters.findIndex(c => c.data.order === chapterOrder);
const prevChapter = currentIndex > 0 ? allChapters[currentIndex - 1] : null;
const nextChapter = currentIndex < totalChapters - 1 ? allChapters[currentIndex + 1] : null;
const progress = Math.round(((currentIndex + 1) / totalChapters) * 100);
---

<Base
  title={`${ch.data.chapterTitle} — 迭代`}
  description={ch.data.summary}
>
  <Header />

  <!-- Reading Progress Bar -->
  <div style="position: fixed; top: 0; left: 0; right: 0; height: 3px; background: var(--border); z-index: 2000;">
    <div style={`height: 100%; width: ${progress}%; background: linear-gradient(90deg, var(--cyan), var(--violet)); transition: width 0.3s ease;`}></div>
  </div>

  <main class="container" style="padding-top: 80px;">
    <header style="padding: 48px 0 40px; text-align: center; border-bottom: 1px solid var(--border); margin-bottom: 48px;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-3); margin-bottom: 20px;">
        <a href="/novel" style="color: var(--text-3);">小说</a>
        <span>›</span>
        <span>{ch.data.partTitle}</span>
        <span>›</span>
        <span style="color: var(--cyan);">第{ch.data.chapter}章</span>
      </div>

      <div style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cyan); margin-bottom: 12px;">
        {ch.data.part}.{ch.data.chapter.toString().padStart(2, '0')}
      </div>

      <h1 style="font-family: var(--font-display); font-size: clamp(1.8rem, 5vw, 3rem); font-weight: 600; letter-spacing: -0.03em; color: var(--text); margin-bottom: 10px; line-height: 1.1;">
        {ch.data.chapterTitle}
      </h1>
      <p style="font-size: 0.9rem; color: var(--text-3); font-style: italic; margin-bottom: 0;">{ch.data.subtitle}</p>

      <div style="display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 20px; font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3);">
        <span>{ch.data.partTitle}</span>
        <span>·</span>
        <span>约{Math.round(ch.data.wordCount / 1000)}千字</span>
        <span>·</span>
        <span>进度{progress}%</span>
      </div>
    </header>

    <article class="novel-content" set:html={ch.data.content || ''}></article>

    <nav style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border);">
      {prevChapter ? (
        <a
          href={`/novel/ch-${prevChapter.data.order}`}
          style="padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); text-decoration: none; transition: all 280ms ease; color: var(--text);"
        >
          <div style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-3); margin-bottom: 6px;">← 上一章</div>
          <div style="font-size: 0.88rem; font-weight: 500;">{prevChapter.data.part}.{prevChapter.data.chapter.toString().padStart(2, '0')} {prevChapter.data.chapterTitle}</div>
        </a>
      ) : (<div></div>)}

      {nextChapter ? (
        <a
          href={`/novel/ch-${nextChapter.data.order}`}
          style="padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); text-decoration: none; transition: all 280ms ease; text-align: right; color: var(--text);"
        >
          <div style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-3); margin-bottom: 6px;">下一章 →</div>
          <div style="font-size: 0.88rem; font-weight: 500;">{nextChapter.data.part}.{nextChapter.data.chapter.toString().padStart(2, '0')} {nextChapter.data.chapterTitle}</div>
        </a>
      ) : (<div></div>)}
    </nav>

    <div style="text-align: center; margin-top: 40px; margin-bottom: 60px;">
      <a href="/novel" class="btn-ghost" style="font-size: 0.85rem;">← 返回小说主页</a>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .novel-content {
    max-width: 680px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 2;
    color: var(--text);
  }
  .novel-content p {
    margin-bottom: 1.6em;
    text-align: justify;
    text-indent: 2em;
  }
  @media (max-width: 640px) {
    nav[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
