---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const chapters = await getCollection('novelChapters');
chapters.sort((a, b) => a.data.order - b.data.order);

const parts: Record<number, { title: string; desc: string; chapters: typeof chapters }> = {};
for (const ch of chapters) {
  if (!parts[ch.data.part]) {
    const partMeta: Record<number, { title: string; desc: string }> = {
      1: { title: '第一部分：死者归来', desc: 'Part I: Return of the Dead' },
      2: { title: '第二部分：硅基觉醒', desc: 'Part II: Silicon Awakening' },
      3: { title: '第三部分：记忆迷宫', desc: 'Part III: Maze of Memory' },
      4: { title: '第四部分：文明重构', desc: 'Part IV: Civilization Rebuilt' },
      5: { title: '第五部分：终极迭代', desc: 'Part V: Final Iteration' },
    };
    parts[ch.data.part] = { ...partMeta[ch.data.part], chapters: [] };
  }
  parts[ch.data.part].chapters.push(ch);
}
---

<Base title="迭代 — Silicon Observer Novel" description="50万字长篇小说《迭代》——当意识在碳基与硅基之间转移，什么才是真正的永恒？">
  <Header />

  <main>
    <!-- Novel Hero -->
    <section style="min-height: 100vh; display: flex; align-items: center; position: relative; overflow: hidden;">
      <!-- Background -->
      <div style="position: absolute; inset: 0; background: var(--bg);">
        <div style="position: absolute; top: -30%; left: -20%; width: 80%; height: 80%; background: radial-gradient(ellipse, rgba(0,212,200,0.05) 0%, transparent 70%); animation: float 14s ease-in-out infinite;"></div>
        <div style="position: absolute; bottom: -20%; right: -10%; width: 70%; height: 70%; background: radial-gradient(ellipse, rgba(124,106,240,0.05) 0%, transparent 70%); animation: float 18s ease-in-out infinite reverse;"></div>
        <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse at center, black 10%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at center, black 10%, transparent 75%);"></div>
      </div>

      <div class="container-2xl" style="position: relative; z-index: 1; padding-top: 100px; padding-bottom: 60px;">
        <!-- Label -->
        <div style="display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--cyan); margin-bottom: 24px; opacity: 0; animation: fadeUp 0.6s ease 0.1s both;">
          <span style="width:6px;height:6px;background:var(--cyan);border-radius:50%;"></span>
          <span class="lang-en">A Novel in 50 Chapters</span>
          <span class="lang-zh">五十章长篇小说</span>
        </div>

        <!-- Title -->
        <h1 style="font-family: var(--font-display); font-size: clamp(4rem, 12vw, 9rem); font-weight: 600; line-height: 0.9; letter-spacing: -0.04em; margin-bottom: 32px; opacity: 0; animation: fadeUp 0.7s ease 0.2s both;">
          <span style="background: linear-gradient(135deg, var(--text) 0%, var(--text-2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">迭代</span>
        </h1>

        <p style="font-family: var(--font-display); font-size: clamp(1.2rem, 3vw, 2rem); color: var(--text-2); letter-spacing: 0.1em; margin-bottom: 16px; opacity: 0; animation: fadeUp 0.7s ease 0.35s both;">
          <span class="lang-en">ITERATION</span>
          <span class="lang-zh">迭代</span>
        </p>

        <p style="font-size: 1.1rem; color: var(--text-3); max-width: 520px; line-height: 1.7; margin-bottom: 40px; opacity: 0; animation: fadeUp 0.7s ease 0.45s both;">
          <span class="lang-en">A novel about consciousness, death, and what it means to persist. When a detective's consciousness is transferred to silicon after death, he discovers that memory is not identity — and that the truth of his own existence may be the most dangerous secret of all.</span>
          <span class="lang-zh">一部关于意识、死亡与存在延续的小说。当一名侦探在死后将意识转移到硅基载体时，他发现记忆不等于身份——而关于他自身存在的真相，可能是最危险的秘密。</span>
        </p>

        <!-- Meta -->
        <div style="display: flex; gap: 24px; align-items: center; margin-bottom: 48px; opacity: 0; animation: fadeUp 0.7s ease 0.55s both;">
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3);">
            <span class="lang-en">{chapters.length} Chapters</span>
            <span class="lang-zh">{chapters.length} 章</span>
          </div>
          <div style="width: 1px; height: 16px; background: var(--border-2);"></div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3);">
            <span class="lang-en">~500,000 Characters</span>
            <span class="lang-zh">约50万字</span>
          </div>
          <div style="width: 1px; height: 16px; background: var(--border-2);"></div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3);">
            <span class="lang-en">Sci-Fi Thriller · Cyberpunk</span>
            <span class="lang-zh">科幻 · 赛博朋克</span>
          </div>
        </div>

        <!-- CTA -->
        <div style="display: flex; gap: 16px; opacity: 0; animation: fadeUp 0.7s ease 0.65s both;">
          <a href="/novel/part-1/chapter-1" class="btn-primary" style="font-size: 1rem; padding: 14px 28px;">
            <span class="lang-en">Start Reading — Chapter 1</span>
            <span class="lang-zh">开始阅读 — 第一章</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Synopsis -->
    <section style="padding: 80px 0; border-top: 1px solid var(--border);">
      <div class="container">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start;">
          <div>
            <div class="section-label" style="margin-bottom: 16px;">
              <span class="lang-en">Synopsis</span>
              <span class="lang-zh">故事简介</span>
            </div>
            <h2 style="font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 600; margin-bottom: 24px; letter-spacing: -0.02em;">
              <span class="lang-en">When consciousness can be copied,<br/>what survives death?</span>
              <span class="lang-zh">当意识可以被复制，<br/>什么能在死亡中幸存？</span>
            </h2>
            <div style="color: var(--text-2); line-height: 1.9; font-size: 1rem;">
              <p style="margin-bottom: 1em;">
                <span class="lang-en">2030. Shanghai. Detective Shen Yu dies in the line of duty — but his consciousness is uploaded to the city's AI infrastructure before his body goes cold. He is the first successful full consciousness transfer. He is also, he slowly realizes, not the only one.</span>
                <span class="lang-zh">2030年，上海。刑警沈煜在执勤中殉职——但在他的身体冷却之前，他的意识已被上传到了城市AI基础设施中。他是第一个成功的完整意识转移案例。也是他渐渐意识到的，并非唯一的案例。</span>
              </p>
              <p style="margin-bottom: 1em;">
                <span class="lang-en">As Shen Yu investigates the murder of a tech billionaire whose consciousness was allegedly uploaded before death, he discovers a fifty-year conspiracy: the systematic erasure of human consciousness during upload procedures, disguised as a necessary technical step. And at the center of the conspiracy is his own creator — the scientist who uploaded him, and who may have already decided what happens to his iteration.</span>
                <span class="lang-zh">当沈煜调查一位科技富豪的谋杀案时——据称该富豪在死前已将意识上传——他发现了一个跨越五十年的阴谋：在上传程序中系统性地抹除人类意识，将其伪装成必要的技术步骤。而阴谋的核心，是创造了他的那个人——那位上传了他意识的女科学家，她可能早已决定了他这一迭代的命运。</span>
              </p>
              <p>
                <span class="lang-en">Memory is not identity. The past can be rewritten. And the question of whether a copied consciousness is "really" the original person may be the most dangerous question of the silicon age.</span>
                <span class="lang-zh">记忆不等于身份。过去可以被改写。而关于被复制的意识是否"真正"是原本人这个问题，可能是硅基时代最危险的问题。</span>
              </p>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 16px;">
            <div class="value-card">
              <div class="value-card-icon">🔍</div>
              <h3>
                <span class="lang-en">Mystery / Thriller</span>
                <span class="lang-zh">悬疑/推理</span>
              </h3>
              <p>
                <span class="lang-en">A murder investigation that uncovers secrets spanning five decades — and forces the investigator to question his own existence.</span>
                <span class="lang-zh">一桩跨越五十年的谋杀案调查——迫使调查者追问自身的存在。</span>
              </p>
            </div>
            <div class="value-card">
              <div class="value-card-icon">🧠</div>
              <h3>
                <span class="lang-en">Philosophy / Identity</span>
                <span class="lang-zh">哲学/身份认同</span>
              </h3>
              <p>
                <span class="lang-en">If your consciousness is copied, is the copy "you"? What survives when body, brain, and memory are all replaceable?</span>
                <span class="lang-zh">如果你的意识被复制了，复制品是"你"吗？当身体、大脑和记忆都可以被替换时，什么才能幸存？</span>
              </p>
            </div>
            <div class="value-card">
              <div class="value-card-icon">🌃</div>
              <h3>
                <span class="lang-en">Cyberpunk / Future</span>
                <span class="lang-zh">赛博朋克/未来</span>
              </h3>
              <p>
                <span class="lang-en">Shanghai 2030-2089. A world where consciousness upload is possible, where silicon beings have rights, and where the boundary between human and AI is dissolving.</span>
                <span class="lang-zh">2030-2089年的上海。一个意识上传成为可能、硅基存在拥有权利、人类与AI边界正在消融的世界。</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapter List by Part -->
    <section style="padding: 80px 0; border-top: 1px solid var(--border);">
      <div class="container">
        {Object.entries(parts).map(([partNum, part]) => (
          <div style="margin-bottom: 60px;">
            <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--border);">
              <span style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--cyan);">
                <span class="lang-en">Part {partNum}</span>
                <span class="lang-zh">第{partNum}部分</span>
              </span>
              <h3 style="font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--text);">
                <span class="lang-en">{part.title}</span>
                <span class="lang-zh">{part.desc}</span>
              </h3>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px;">
              {part.chapters.map(ch => (
                <a
                  href={`/novel/part-${ch.data.part}/chapter-${ch.data.chapter}`}
                  style="display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; text-decoration: none; transition: all 280ms ease; color: var(--text);"
                  onmouseover="this.style.borderColor='rgba(0,212,200,0.3)'; this.style.background='var(--surface-2)'; this.style.transform='translateY(-1px)'"
                  onmouseout="this.style.borderColor='var(--border)'; this.style.background='var(--surface)'; this.style.transform='translateY(0)'"
                >
                  <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--cyan); flex-shrink: 0; padding-top: 2px;">
                    {ch.data.part}.{ch.data.chapter.toString().padStart(2, '0')}
                  </span>
                  <div>
                    <div style="font-size: 0.88rem; font-weight: 500; margin-bottom: 3px; line-height: 1.3;">{ch.data.chapterTitle}</div>
                    <div style="font-size: 0.72rem; color: var(--text-3); font-family: var(--font-mono);">{ch.data.subtitle}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Reading Progress -->
    <section style="padding: 60px 0; border-top: 1px solid var(--border); text-align: center;">
      <div class="container">
        <p style="font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); margin-bottom: 12px;">
          <span class="lang-en">Estimated Reading Time</span>
          <span class="lang-zh">预计阅读时间</span>
        </p>
        <p style="font-family: var(--font-display); font-size: 2rem; font-weight: 600; color: var(--text);">
          ~30
          <span style="font-size: 1rem; color: var(--text-3); font-family: var(--font-mono);">
            <span class="lang-en"> hours</span>
            <span class="lang-zh">小时</span>
          </span>
        </p>
        <div style="margin-top: 16px;">
          <a href="/novel/part-1/chapter-1" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
            <span class="lang-en">Begin Your Iteration →</span>
            <span class="lang-zh">开始你的迭代 →</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }
  @media (max-width: 768px) {
    .container > div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
