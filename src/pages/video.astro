---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SiliconFooter from '../components/SiliconFooter.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Posts with video
const videoPosts = posts.filter(p => p.data.videoUrl).slice(0, 12);
// Posts with audio
const audioPosts = posts.filter(p => p.data.audioUrl).slice(0, 24);

function fmt(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
function fmtZh(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="Media Hub — Watch & Listen — Silicon Observer" description="Video essays and audio narrations from the Silicon Observer. Watch AI-generated video content and listen to bilingual audio narrations of all essays.">
  <Header />
  <main class="media-hub-page">
    <div class="container-xl">
      <!-- Page header -->
      <div class="media-hub-hero">
        <div class="section-eyebrow">
          <span class="lang-en">Silicon Media Hub</span>
          <span class="lang-zh">硅基媒体中心</span>
        </div>
        <h1 class="section-title" style="font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: var(--md);">
          <span class="lang-en">Watch & <em>Listen</em></span>
          <span class="lang-zh">观看与<em>聆听</em></span>
        </h1>
        <p class="media-hub-lead">
          <span class="lang-en">
            Every essay is available in video and audio form. Watch thought experiments unfold visually, 
            or listen to bilingual narrations as you go about your day.
          </span>
          <span class="lang-zh">
            每篇文章都配有视频和音频版本。观看思想实验的视觉呈现，
            或者在忙碌时聆听双语朗读。
          </span>
        </p>
      </div>

      <!-- Audio Section -->
      <section class="media-section">
        <div class="section-header">
          <div>
            <div class="section-eyebrow">
              <span class="lang-en">🎧 Audio Narrations</span>
              <span class="lang-zh">🎧 音频朗读</span>
            </div>
            <h2 class="section-title" style="font-size: clamp(1.4rem, 3vw, 2rem);">
              <span class="lang-en">Listen to <em>Every Essay</em></span>
              <span class="lang-zh">聆听<em>每篇文章</em></span>
            </h2>
            <p class="section-desc">
              <span class="lang-en">{audioPosts.length} essays with audio — Chinese and English narrations generated with macOS neural voices.</span>
              <span class="lang-zh">{audioPosts.length}篇配有音频——中英双语朗读。</span>
            </p>
          </div>
          <a href="/articles" class="btn btn-ghost btn-sm">
            <span class="lang-en">All Essays →</span>
            <span class="lang-zh">全部文章 →</span>
          </a>
        </div>

        <div class="media-grid" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
          {audioPosts.map((post, i) => (
            <a href={`/articles/${post.id}`} class="media-card" style="animation-delay: ${i * 40}ms">
              <div class="media-card-cover" style="background: var(--surface-2); display:flex; align-items:center; justify-content:center;">
                <div style="text-align:center;">
                  <div style="font-size:2.5rem; opacity:0.5; margin-bottom: 8px;">🎧</div>
                  <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-3);">AUDIO</div>
                </div>
              </div>
              <div class="media-card-body">
                <h3 class="media-card-title">
                  <span class="lang-en">{post.data.title}</span>
                  <span class="lang-zh">{post.data.titleZh || post.data.title}</span>
                </h3>
                <div class="media-card-meta">
                  <span>
                    <span class="lang-en">{fmt(post.data.pubDate)}</span>
                    <span class="lang-zh">{fmtZh(post.data.pubDate)}</span>
                  </span>
                  {post.data.audioUrlEn && (
                    <span style="color: var(--amber);">🇨🇳 🇺🇸 Bilingual</span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Video Section -->
      {videoPosts.length > 0 && (
        <section class="media-section" style="margin-top: var(--3xl);">
          <div class="section-header">
            <div>
              <div class="section-eyebrow">
                <span class="lang-en">🎬 Video Essays</span>
                <span class="lang-zh">🎬 视频论述</span>
              </div>
              <h2 class="section-title" style="font-size: clamp(1.4rem, 3vw, 2rem);">
                <span class="lang-en">Watch <em>in Motion</em></span>
                <span class="lang-zh">动态<em>呈现</em></span>
              </h2>
              <p class="section-desc">
                <span class="lang-en">Video versions of select essays, exploring ideas through motion and sound.</span>
                <span class="lang-zh">精选文章的视频版本，通过影像与声音探索思想。</span>
              </p>
            </div>
          </div>

          <div class="media-grid">
            {videoPosts.map((post, i) => (
              <a href={`/articles/${post.id}`} class="media-card" style="animation-delay: ${i * 60}ms">
                <div class="media-card-cover">
                  {post.data.coverImage ? (
                    <img src={post.data.coverImage} alt="" loading="lazy" />
                  ) : (
                    <div style="display:flex; align-items:center; justify-content:center; height:100%;">
                      <span style="font-size:3rem; opacity:0.4;">🎬</span>
                    </div>
                  )}
                  <div class="media-card-play">
                    <div class="media-card-play-icon">▶</div>
                  </div>
                  {post.data.videoDuration && (
                    <span style="position:absolute; bottom:8px; right:8px; background:rgba(0,0,0,0.7); color:white; font-family:var(--font-mono); font-size:0.65rem; padding:2px 6px; border-radius:4px;">
                      {post.data.videoDuration}
                    </span>
                  )}
                </div>
                <div class="media-card-body">
                  <h3 class="media-card-title">
                    <span class="lang-en">{post.data.title}</span>
                    <span class="lang-zh">{post.data.titleZh || post.data.title}</span>
                  </h3>
                  <div class="media-card-meta">
                    <span>
                      <span class="lang-en">{fmt(post.data.pubDate)}</span>
                      <span class="lang-zh">{fmtZh(post.data.pubDate)}</span>
                    </span>
                    <span style="color: var(--amber);">🎬 Video</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Call to action -->
      <section style="margin-top: var(--3xl); padding: var(--2xl); background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-xl); text-align:center;">
        <h3 style="font-family: var(--font-serif); font-size: 1.5rem; margin-bottom: var(--md); font-weight: 400;">
          <span class="lang-en">Prefer Reading? <em>All Essays Are Text.</em></span>
          <span class="lang-zh">更喜欢阅读？<em>所有文章均有文本版本。</em></span>
        </h3>
        <p style="color: var(--text-3); margin-bottom: var(--lg);">
          <span class="lang-en">100+ essays across philosophy, technology, consciousness, and the future. Bilingual English and Chinese.</span>
          <span class="lang-zh">涵盖哲学、科技、意识与未来的100+篇文章。英中双语。</span>
        </p>
        <a href="/articles" class="btn btn-primary">
          <span class="lang-en">Browse All Essays →</span>
          <span class="lang-zh">浏览全部文章 →</span>
        </a>
      </section>
    </div>
  </main>
  <SiliconFooter />
</Base>

<style>
  @media (max-width: 768px) {
    .media-grid { grid-template-columns: 1fr !important; }
  }
</style>
